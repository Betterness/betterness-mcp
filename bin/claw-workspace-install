#!/usr/bin/env bash
set -euo pipefail

# ─── claw workspace install ───
# Wrapper that simulates `claw workspace install betterness/<package>`
# by copying BetterClaw OS starter templates into an OpenClaw workspace
# and wiring up the Betterness MCP connection.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STARTERS="$REPO_ROOT/starters/betterclaw-os"
WORKSPACE_ROOT="${CLAW_WORKSPACE_DIR:-$HOME/.openclaw/workspaces}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PINK='\033[0;35m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

usage() {
  echo -e "${BOLD}Usage:${RESET} claw workspace install betterness/<package>"
  echo ""
  echo "Available packages:"
  for pkg in "$STARTERS"/*/; do
    [ -d "$pkg" ] || continue
    name=$(basename "$pkg")
    echo -e "  ${GREEN}betterness/$name${RESET}"
  done
  echo ""
  echo "Options:"
  echo "  --key <API_KEY>   Betterness MCP API key (or set BETTERNESS_API_KEY)"
  echo "  --dir <PATH>      Custom workspace directory"
  exit 1
}

# Parse args
PACKAGE=""
API_KEY="${BETTERNESS_API_KEY:-}"
CUSTOM_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    betterness/*)
      PACKAGE="${1#betterness/}"
      shift
      ;;
    --key)
      API_KEY="$2"
      shift 2
      ;;
    --dir)
      CUSTOM_DIR="$2"
      shift 2
      ;;
    install)
      shift
      ;;
    workspace)
      shift
      ;;
    *)
      usage
      ;;
  esac
done

[ -z "$PACKAGE" ] && usage

# Validate package exists
if [ ! -d "$STARTERS/$PACKAGE" ]; then
  echo -e "${YELLOW}Error:${RESET} Package 'betterness/$PACKAGE' not found."
  echo ""
  echo "Available packages:"
  for pkg in "$STARTERS"/*/; do
    [ -d "$pkg" ] || continue
    echo -e "  betterness/$(basename "$pkg")"
  done
  exit 1
fi

# Target directory
TARGET="${CUSTOM_DIR:-$WORKSPACE_ROOT/betterness-$PACKAGE}"

echo ""
echo -e "${GREEN}${BOLD}  claw workspace install${RESET} betterness/$PACKAGE"
echo -e "${DIM}  ─────────────────────────────────────────${RESET}"
echo ""

# Step 1: Create workspace
echo -e "  ${GREEN}▸${RESET} Creating workspace at ${DIM}$TARGET${RESET}"
mkdir -p "$TARGET"
cp -r "$STARTERS/$PACKAGE/"* "$TARGET/"
echo -e "  ${GREEN}✓${RESET} Workspace files installed"

# Step 2: Write MCP config
echo -e "  ${GREEN}▸${RESET} Configuring Betterness MCP connection"
if [ -n "$API_KEY" ]; then
  cat > "$TARGET/.mcp.json" <<MCPEOF
{
  "mcpServers": {
    "betterness": {
      "url": "https://mcp.betterness.ai/mcp",
      "headers": {
        "Authorization": "Bearer $API_KEY"
      }
    }
  }
}
MCPEOF
  echo -e "  ${GREEN}✓${RESET} MCP configured with API key"
else
  cat > "$TARGET/.mcp.json" <<MCPEOF
{
  "mcpServers": {
    "betterness": {
      "url": "https://mcp.betterness.ai/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_API_KEY"
      }
    }
  }
}
MCPEOF
  echo -e "  ${YELLOW}!${RESET} MCP config written — update YOUR_API_KEY in .mcp.json"
  echo -e "    ${DIM}Get your key at https://betterness.ai/dashboard${RESET}"
fi

# Step 3: Summary
SKILL_COUNT=$(find "$TARGET/skills" -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
MODULE_COUNT=$(find "$TARGET/modules" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')

echo ""
echo -e "  ${GREEN}${BOLD}Workspace ready.${RESET}"
echo ""
echo -e "  ${DIM}Package:${RESET}    betterness/$PACKAGE"
echo -e "  ${DIM}Location:${RESET}   $TARGET"
echo -e "  ${DIM}Skills:${RESET}     $SKILL_COUNT"
echo -e "  ${DIM}Modules:${RESET}    $MODULE_COUNT"
echo -e "  ${DIM}MCP:${RESET}        https://mcp.betterness.ai/mcp"
echo ""
echo -e "  ${PINK}Next:${RESET} cd $TARGET && claw start"
echo ""
